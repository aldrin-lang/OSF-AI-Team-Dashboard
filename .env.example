# ---------------------------------------------------------------------------
# Supabase (NEW project only — never the client-portal project cjaqdxfqjxnepjentgwb)
# Region: Singapore (ap-southeast-1)
# ---------------------------------------------------------------------------
# Server-side. The browser gets URL + anon key from /api/public-config at RUNTIME
# (this account's Vercel build-time NEXT_PUBLIC_ inlining is unreliable — see plan).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Also expose as NEXT_PUBLIC_ for local dev convenience; production reads runtime route.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="AI Receptionist Ops <ops@notifications.yourdomain.com>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Shared secret required in the x-cron-secret header on /api/cron/daily
CRON_SECRET=

# ---------------------------------------------------------------------------
# Leads hub (GHL -> dashboard) — see HANDOVER.md
# ---------------------------------------------------------------------------
# Shared secret the GHL workflow sends to POST /api/webhooks/ghl-lead
# (header x-webhook-secret, or ?key= on the URL). Unset = webhook refuses (503).
GHL_WEBHOOK_SECRET=
# Read-only GHL access for "Sync now" / backfill. Private Integration Token with
# opportunities.readonly + contacts.readonly. NEVER commit it; set in Vercel only.
GHL_API_TOKEN=
GHL_LOCATION_ID=3OCKmBzU7auXzRIFfHOv
# Optional: limit sync to one pipeline (the "ALatest Leads" pipeline id)
GHL_PIPELINE_ID=
# Optional: Google Chat incoming webhook for "no leads for 24h" alerts
GOOGLE_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# AI (candidate screening, check-in drafts + reply reading, daily report summary)
# ---------------------------------------------------------------------------
# Anthropic API key. Unset = everything still works with plain templates.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
AI_MODEL=
# Optional: where client/VA replies to check-ins and payment reminders go
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Sourci (voice assistant, admins only)
# ---------------------------------------------------------------------------
# OpenAI key for Sourci's brain (required to switch Sourci on). Model default gpt-5-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
# How hard Sourci thinks: minimal (fastest) | low (default) | medium | high
OPENAI_REASONING=
# Optional ElevenLabs voice; without these Sourci uses the browser's built-in voice.
ELEVENLABS_API_KEY=
# Optional: fixed voice ID (else the picker's voice, default Lily)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
